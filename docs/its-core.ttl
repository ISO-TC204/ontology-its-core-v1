BASE   <https://w3id.org/itsdata/core/v1/>
PREFIX : <https://w3id.org/itsdata/core/v1/>
PREFIX dash: <http://datashapes.org/dash#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX cdm1: <https://w3id.org/citydata/part1/v1/>
PREFIX cdm2: <https://w3id.org/citydata/part2/v1/>
PREFIX i72: <https://w3id.org/citydata/21972/v1/>
PREFIX schema: <https://schema.org/>

: a owl:Ontology;
    # Ontology metadata
    dcterms:title                  "ITS Core Ontology"@en;
    skos:definition                "This ontology defines core concepts related to intelligent transport systems (ITS)."@en;
    vann:preferredNamespaceUri     "https://w3id.org/itsdata/core/v1/";
    vann:preferredNamespacePrefix  "its-core";
    dcterms:license                "http://creativecommons.org/licenses/by/4.0/";
    :draft                 "true";
    
    #Provenance metadata
    dcterms:creator                "Kenneth Vaughn";
    dcterms:created                "Draft";
    dcterms:modified               "2026-07-27"^^xsd:date ;
    owl:versionInfo                "0.0.3-alpha.4" ;
    owl:versionIRI                 <https://w3id.org/itsdata/core/v1/0.0.3-alpha.4> ;
    owl:priorVersion               <https://w3id.org/itsdata/core/v1/0.0.3-alpha.3> ;
    
    # Imports
    owl:imports                    cdm2:CityPattern .
    # which includes the following cascade of imports:
    #     LandUsePattern
    #         CodePattern
    #             Core(cdm2)
    #             OrganizationStructurePattern
    #                 AgentPattern
    #                    GenericPropertiesPattern
    #                    ResourcePattern
    #                        ActivityPattern
    #                            ChangePattern
    #                            SpatialLocPattern
    #                                MereologyPattern
    #                        CityUnitsPattern
    #                             ISO21972
    #                             Core (cdm1)
    #                                 Time (W3C)


# ================================================
#                Annotation Properties
# ================================================

:reqviewId a owl:AnnotationProperty;
    rdfs:label "reqviewId" ;
    rdfs:comment "An annotation property to link a requirement to its corresponding ReqView ID to enable traceability in requirements management." .

# ================================================
#                Object Properties
# ================================================

:ITSObjectProperty a owl:ObjectProperty;
    skos:definition  "An object property to organize all object properties defined in all recognized ITS Ontologies." .

:enteredBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf  :ITSObjectProperty;
    schema:domainIncludes :OfficialThing ;
    schema:rangeIncludes cdm1:Agent ;
    skos:definition "The Agent that entered the OfficialThing."@en ;
    skos:example "The City of Los Angeles"@en .

:fromCodeList
    a owl:ObjectProperty ;
    rdfs:subPropertyOf  :ITSObjectProperty;
    schema:domainIncludes :Code ;
    schema:rangeIncludes :CodeList ;
    skos:definition "Associates a code with the code list that defines it."@en .

:hasActivationStatus a owl:ObjectProperty;
    skos:definition     "The activation status of the object.";
    rdfs:subPropertyOf  :ITSObjectProperty;
    schema:rangeIncludes          :ActivationStatusCode .

:hasJurisdiction a owl:ObjectProperty;
    rdfs:subPropertyOf  :ITSObjectProperty;
    skos:definition     "The jurisdiction associated with the object.";
    schema:rangeIncludes          cdm2:JurisdictionalArea .

:hasRegisteredCode
    a owl:ObjectProperty ;
    rdfs:subPropertyOf  :ITSObjectProperty;
    schema:domainIncludes :CodeList ;
    schema:rangeIncludes :Code ;
    skos:definition "Associates a code list with a registered member code."@en .

:issuingAuthority
    rdf:type            owl:ObjectProperty ;
    rdfs:subPropertyOf  :ITSObjectProperty ;
    schema:domainIncludes :OfficialThing ;
    schema:rangeIncludes cdm1:Agent ;
    skos:definition "The Agent that issued the OfficialThing."@en ;
    skos:example "The City of Los Angeles"@en ;
    skos:editorsNote "Changed from a simple string to a pointer to an Agent (i.e., a person, organization, software agent, or group)."@en ;
    skos:editorsNote "Moved from TRO to the more abstract OfficialThing as it can apply to code lists, definitions of defined areas, etc."@en .

:managedBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf  :ITSObjectProperty;
    schema:domainIncludes :CodeList ;
    schema:rangeIncludes cdm2:Organization ;
    skos:definition "Associates a code list with a registered member code."@en .

# ================================================
#                Datatype Properties
# ================================================

:ITSDataProperty a owl:DatatypeProperty;
    skos:definition  "A datatype property to organize all datatype properties defined in all recognized ITS Ontologies." .

:codeValue a owl:DatatypeProperty ;
    rdfs:subPropertyOf  :ITSDataProperty;
    schema:domainIncludes :Code ;
    schema:rangeIncludes xsd:string ;
    skos:definition "The lexical value of a code."@en .

:enteredOn a owl:DatatypeProperty ;
    rdfs:subPropertyOf  :ITSDataProperty;
    schema:domainIncludes :OfficialThing ;
    schema:rangeIncludes xsd:dateTime ;
    skos:definition "The date the OfficialThing was entered."@en ;
    skos:example "2026-01-01T00:00:00Z"@en .

:hasImage a owl:DatatypeProperty;
    skos:definition     "The binary content of an image embedded as base64-encoded bytes.";
    rdfs:subPropertyOf  :ITSDataProperty;
    schema:rangeIncludes          xsd:base64Binary .

:hasMaintainer a owl:DatatypeProperty ;
    rdfs:subPropertyOf  :ITSDataProperty;
    schema:domainIncludes :CodeList ;
    schema:rangeIncludes xsd:string ;
    skos:definition "The maintainer of the code list (free-text identifier; can be replaced with a richer organization model later)."@en .

:hasName a owl:DatatypeProperty ;
    rdfs:subPropertyOf  :ITSDataProperty;
    schema:domainIncludes :CodeList ;
    schema:rangeIncludes rdf:langString ;
    skos:definition "A human-readable name for the code list."@en .

:hasUrl a owl:DatatypeProperty;
    skos:definition     "The URL associated with the object.";
    rdfs:subPropertyOf  :ITSDataProperty;
    schema:rangeIncludes          xsd:anyURI .

:hasVersion a owl:DatatypeProperty;
    rdfs:subPropertyOf  :ITSDataProperty;
    skos:definition     "The version of the object." .

:issuedOn a owl:DatatypeProperty ;
    rdfs:subPropertyOf  :ITSDataProperty;
    schema:domainIncludes :OfficialThing ;
    schema:rangeIncludes xsd:date ;
    skos:definition "The date the OfficialThing was issued."@en ;
    skos:example "2026-01-01"@en .

:lastModified a owl:DatatypeProperty ;
    rdfs:subPropertyOf  :ITSDataProperty;
    schema:domainIncludes :CodeList ;
    schema:rangeIncludes xsd:date ;
    skos:definition "Date the code list was last modified."@en .

# ================================================
#                 Classes
# ================================================

:ITSThing a owl:Class;
    skos:definition  "A class to organize all classes defined in all recognized ITS Ontologies." .

:ActivationStatusCode a owl:Class;
    skos:definition  "A code indicating the activation status of an object";
    skos:example     "active, beingSetUp, beingShutDown, inactive, scheduled";
    rdfs:subClassOf  :ITSThing;
    rdfs:subClassOf  :Code .

:Angle
    rdf:type        owl:Class ;
    rdfs:subClassOf :ITSThing ;
    rdfs:subClassOf i72:Quantity ;
    rdfs:subClassOf [
        owl:allValuesFrom [
            owl:intersectionOf ( i72:Measure [
                owl:allValuesFrom :AngleUnit ;
                owl:onProperty    i72:unit_of_measure ;
                rdf:type          owl:Restriction ;
            ] ) ;
            rdf:type           owl:Class ;
        ] ;
        owl:onProperty    i72:value ;
        rdf:type          owl:Restriction ;
    ] ;
    skos:definition "An angle defined by two lines."@en .

:AngleUnit
    rdf:type        owl:Class ;
    rdfs:subClassOf :ITSThing ;
    rdfs:subClassOf i72:Unit_of_measure ;
    skos:definition "A specified system of units for angles."@en .

:Bearing
    rdf:type        owl:Class ;
    rdfs:subClassOf :Direction ;
    rdfs:subClassOf :Angle ;
    skos:definition "The orientation of a line or movement, measured from north (0°) clockwise."@en ;
    skos:example    "0°, 90°, 180°, 270°, 360°"@en .

:Code
    a owl:Class ;
    skos:definition "A code value whose meaning is defined by membership in (or reference to) a code list."@en ;
    rdfs:subClassOf  :ITSThing;
    rdfs:subClassOf  cdm2:Code .

:CodeList
    a owl:Class ;
    skos:definition "A curated set of codes (a code list), maintained and versioned by some entity."@en ;
    rdfs:subClassOf  :OfficialThing ;
    rdfs:subClassOf  :VersionedThing ;
    rdfs:subClassOf [
        rdf:type                    owl:Restriction ;
        owl:onProperty              cdm1:hasComponent ;
        owl:minQualifiedCardinality    "1"^^xsd:nonNegativeInteger ;
        owl:class                   :Code ;
    ] ;
    skos:definition "A curated set of codes (a code list), maintained and versioned by some entity."@en .

:ComparisonOperatorCode
    rdf:type        owl:Class ;
    rdfs:subClassOf :ITSThing ;
    rdfs:subClassOf :Code ;
    skos:definition "A code representing a comparison operator."@en ;
    skos:example     "equals, not equals, greater than, less than, greater than or equal to, less than or equal to"@en .

:Direction
    rdf:type        owl:Class ;
    rdfs:subClassOf :ITSThing ;
    skos:definition "The orientation of a line or movement."@en .

:DirectionCode
    rdf:type        owl:Class ;
    rdfs:subClassOf :Direction ;
    rdfs:subClassOf :Code ;
    skos:definition "A code representing orientation of a line or movement."@en ;
    skos:example     "north, inbound, positive, clockwise"@en .

:OfficialThing
    rdf:type        owl:Class ;
    rdfs:subClassOf :ITSThing ;
    dash:abstract "true" ;
    rdfs:subClassOf [   
        rdf:type                    owl:Restriction ;
        owl:onProperty              cdm1:issuingAuthority ;
        owl:qualifiedCardinality    "1"^^xsd:nonNegativeInteger ;
        owl:class                   cdm1:Agent ;
    ] ;
    skos:definition "An item that is officially issued by an Agent."@en .

:VersionedThing
    rdf:type        owl:Class ;
    rdfs:subClassOf :ITSThing ;
    dash:abstract "true" ;
    rdfs:subClassOf cdm1:Manifestation ;
    rdfs:subClassOf [
        rdf:type                    owl:Restriction ;
        owl:onProperty              cdm1:hasVersion ;
        owl:datatype                xsd:string ;
        owl:qualifiedCardinality    "1"^^xsd:nonNegativeInteger
    ] ;
    skos:definition "An identifiable version of a managed object."@en .

